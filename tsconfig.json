{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": false,
        "noEmit": true,
        "types": [],
        "paths": {
            "preact": ["./node_modules/preact/src/index.d.ts"]
        }
    },
    "include": ["src", "types"],
    "extends": "./tsconfig.strict.json",
    "exclude": ["src/__tests__"]
}
