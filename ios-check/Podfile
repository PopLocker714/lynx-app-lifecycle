source "https://cdn.cocoapods.org/"
platform :ios, "12.0"
use_frameworks! :linkage => :static
project "LifecycleCheck.xcodeproj"
target "LifecycleCheck" do
    pod "Lynx", "3.9.0"
    pod "LynxAppLifecycle", :path => "../ios"
end

# Xcode 27.2 diagnoses C99 designators in Lynx 3.9 C++ sources and
# deprecated UIKit APIs and discarded nodiscard results below. Preserve warnings
# while avoiding upstream per-file -Werror failures in this SDK fixture only.
# Our module and all other diagnostics stay strict; reassess on Lynx upgrade.
post_install do |installer|
    installer.pods_project.targets.select { |target| target.name == "Lynx" }.each do |target|
        target.source_build_phase.files.each do |file|
            file.settings ||= {}
            flags = "#{file.settings["COMPILER_FLAGS"]} -Wno-error=c99-designator"
            # The fixture target is iOS 15; legacy Lynx UIKit paths stay visible.
            flags += " -Wno-error=deprecated-declarations"
            # The scheduler waits with future.get(); the renderer discards a
            # shared_ptr.get() result. Keep both upstream diagnostics visible.
            path = file.file_ref&.path.to_s
            if path.end_with?("parallel_parse_task_scheduler.cc", "LynxTemplateRender.mm")
                flags += " -Wno-error=unused-result"
            end
            # Lynx overrides a legacy NSLayoutManager method on this path.
            if path.end_with?("LynxTextLayoutManager.m")
                flags += " -Wno-error=deprecated-implementations"
            end
            file.settings["COMPILER_FLAGS"] = flags
        end
    end
end
