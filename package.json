{
  "name": "@lynx-lab/app-lifecycle",
  "version": "0.0.0-development",
  "description": "App foreground/background lifecycle for Lynx — the signal Lynx dispatches but never wires to the app, plus free page-visibility events.",
  "license": "MIT",
  "author": "PopLocker714",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PopLocker714/lynx-app-lifecycle.git"
  },
  "bugs": "https://github.com/PopLocker714/lynx-app-lifecycle/issues",
  "homepage": "https://github.com/PopLocker714/lynx-app-lifecycle#readme",
  "keywords": [
    "lynx",
    "lynxjs",
    "lynx-native-module",
    "app-state",
    "lifecycle",
    "foreground",
    "background",
    "visibility"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./lynx.lib.json": "./lynx.lib.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/__tests__",
    "android",
    "!android/build",
    "!android/.gradle",
    "ios",
    "lynx.lib.json",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepack": "bun run build",
    "prepublishOnly": "node scripts/check-publishable.mjs",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.124.0",
    "@lynx-js/types": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@lynx-js/react": {
      "optional": true
    },
    "@lynx-js/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@lynx-js/react": "^0.125.0",
    "@lynx-js/types": "^4.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.0"
}
